# ─── Backend Environment Variables ───────────────────────────────────────────
# Copy to backend/.env

DATABASE_URL="postgresql://user:password@localhost:5432/house_design_studio"
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Anthropic AI (Claude)
ANTHROPIC_API_KEY="sk-ant-..."

# Image Generation (choose one provider)
IMAGE_GEN_PROVIDER="openai"          # openai | stability | replicate | mock
OPENAI_API_KEY="sk-..."
STABILITY_API_KEY="sk-..."
REPLICATE_API_TOKEN="r8_..."

# Stripe (monetization)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# App
PORT=8080
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
ADMIN_EMAILS="admin@example.com"
MAX_UPLOAD_SIZE_MB=10

# ─── Frontend Environment Variables ──────────────────────────────────────────
# Copy to frontend/.env
VITE_API_URL="http://localhost:8080/api"
VITE_API_PROXY_TARGET="http://localhost:8080"
VITE_APP_NAME="House Design Studio"
